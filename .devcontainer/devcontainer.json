{
  "name": "Biblioteca MVC com dotnet 8",
  "image": "mcr.microsoft.com/devcontainers/dotnet:8.0-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp"
      ]
    }
  },
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "BibliotecaWeb",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  }
}
